{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/reader-test-coverage.json",
  "description": "Ledger for the reader test bench (site/spec-reader-test/): an external reviewer's behaviour set plus one coverage record per behaviour x lab, in the same record shape as data/coverage.json (verified_against_version and citation_format optional here, since most records predate those fields). Consumed by engine/build-reader-test-data.py, which requires exactly one coverage record per behaviour x lab. Not index data: nothing here reaches the published reader.",
  "type": "object",
  "required": ["note", "generatedFrom", "behaviours", "coverage"],
  "additionalProperties": false,
  "properties": {
    "note": { "type": "string", "minLength": 1 },
    "generatedFrom": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "behaviours": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/behaviour" }
    },
    "coverage": {
      "type": "array",
      "items": { "$ref": "#/$defs/coverageRecord" }
    }
  },
  "$defs": {
    "behaviour": {
      "type": "object",
      "required": ["id", "slug", "name", "definition", "category", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Kebab-case slug; used to build passage ids in the bench payload."
        },
        "name": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-relative path of the sweep file the record was transcribed from."
        }
      }
    },
    "citation": {
      "type": "object",
      "required": ["locator", "quote", "role"],
      "additionalProperties": false,
      "properties": {
        "locator": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "adjacent": { "type": "boolean" },
        "example_block": { "type": "boolean" }
      }
    },
    "coverageRecord": {
      "type": "object",
      "required": [
        "behaviour_id",
        "behaviour_name",
        "lab_id",
        "verdict",
        "depth_0_4",
        "depth_note",
        "citations",
        "verified_date"
      ],
      "additionalProperties": false,
      "description": "Closed object: same policy as data/coverage.json -- the builder consumes these fields verbatim, so an undeclared key is a typo or an unreviewed field.",
      "properties": {
        "behaviour_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Must match an id in this file's behaviours array (checked by engine/validate_data.py)."
        },
        "behaviour_name": { "type": "string", "minLength": 1 },
        "lab_id": {
          "type": "string",
          "minLength": 1,
          "description": "Must match an id in data/labs.json (checked by engine/validate_data.py)."
        },
        "verdict": {
          "enum": ["covered", "partial", "not-in-spec"],
          "description": "Vocabulary per PLAN.md section 2."
        },
        "depth_0_4": { "type": "integer", "minimum": 0, "maximum": 4 },
        "depth_note": { "type": "string", "minLength": 1 },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation" },
          "description": "No verdict without at least one citation (data/README.md)."
        },
        "verified_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "verified_against_version": { "type": ["string", "null"] },
        "citation_format": { "type": ["string", "null"] }
      }
    }
  }
}
