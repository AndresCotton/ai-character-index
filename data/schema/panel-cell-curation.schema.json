{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Panel cell curation (data/panel-cell-curation.json)",
  "description": "Per-lab cell summaries (verdict/depth/verifiedDate) that engine/panel/build_site_data.py ships beside the panel payload's passages. Slug-keyed; the join key is (slug, lab_id).",
  "type": "object",
  "additionalProperties": false,
  "required": ["note", "cells"],
  "properties": {
    "note": { "type": "string" },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "lab_id", "verdict", "depth_0_4", "verified_date"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "lab_id": { "type": "string" },
          "verdict": { "type": ["string", "null"] },
          "depth_0_4": { "type": ["integer", "null"], "minimum": 0, "maximum": 4 },
          "verified_date": { "type": "string" }
        }
      }
    }
  }
}
