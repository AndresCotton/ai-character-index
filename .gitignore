.DS_Store
node_modules/
dist/
.env
*.log

# Python bytecode and test caches
__pycache__/
*.pyc
.pytest_cache/

# Panel run outputs stay local: each engine/panel/build_site_data.py run emits a
# timestamped payload and updates the manifest; neither is pushed. The tracked
# site/llm-panel-review/data/behaviours.json is the fresh-clone fallback. (The
# tracked calibration variants behaviours-v*.json predate this rule; gitignore
# only covers files git does not already track.)
site/llm-panel-review/data/behaviours-*.json
site/llm-panel-review/data/manifest.json

# Regenerable experiment artifacts: virtualenvs and model-weight caches
.venv*/
venv/
ckpts/
.claude/settings.local.json
.claude/settings.json
.claude/launch.json
.claude/worktrees/

# Private -- not for the public repo
research/sources/Founding an AI Charter organisation.pdf
outreach/

# Builder smoke-test scratch (engine/test_build_reader_test_data.py)
.builder-repro-scratch/
